# Copy to .env and fill in. .env is git-ignored — credentials never leave your machine.
# A DEMO account is enough to download the instrument list.
XTB_USER_ID=1234567
XTB_PASSWORD=your-password
# demo | real
XTB_MODE=demo

# Optional: raises the OpenFIGI rate limit and per-request batch size (10 -> 100)
# for `xtb-analyzer map --figi`. Leave unset to use the public, unauthenticated tier.
OPENFIGI_API_KEY=
