# Copy to .env and fill in. .env is git-ignored — credentials never leave your machine.
# A DEMO account is enough to download the instrument list.
XTB_USER_ID=1234567
XTB_PASSWORD=your-password
# demo | real
XTB_MODE=demo

# Optional: raises the OpenFIGI rate limit for `xtb-analyzer map --isin`.
# Leave unset to use the public, unauthenticated tier (25 requests / 6s).
OPENFIGI_API_KEY=
